# Copy to .env.local for development. Nothing here is a real secret; production uses wrangler.toml and `wrangler secret put` (docs/deploy-web.md).
WORKER_URL=http://127.0.0.1:8787
NEXT_PUBLIC_WORKER_WS_URL=ws://127.0.0.1:8787
ENGINE_URL=http://127.0.0.1:8765
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=seti-worker
# PKCS8 PEM of the ES256 private key, with the line breaks written as \n (the Worker gets the matching public key as AUTH_PUBLIC_KEY)
AUTH_PRIVATE_KEY=
# development: a local SQLite file with the Worker's schema; DB_MODE=d1 with the three CF_ values reads the real D1 over its REST API (tools only:
# in production the Worker uses the D1 binding)
DB_MODE=sqlite
SQLITE_PATH=.data/dev.sqlite
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=
# Cloudflare Turnstile on signup, login and guest play. For development use the always-passing test keys of Cloudflare:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA. Without a secret the check is skipped in development
# and always refuses in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# PKCS8 PEM ES256 private key (line breaks as 
) that signs the site's requests to the engine service; its public key goes into the engine's
# ENGINE_TRUSTED_KEYS under the name "web" (docs/deploy-engine.md). Leave empty in development.
ENGINE_SIGNING_KEY=
