# Local data and logs
.data/
*.sqlite
*.sqlite-journal
*.db
*.log
npm-debug.log*
pnpm-debug.log*

# Editors, operating systems, scratch
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.tmp
tmp/
scratch/

# Owner-supplied source images and rulebooks (CGE's material, 515 MB): kept on the owner's disk, not in git.
# The web-sized images the site serves are generated from them by tools/web/build_assets.py and are tracked in apps/web/public/assets.
/assets/
/docs/rules/

# a saved copy of a web page for reading (third-party content, not part of the project)
docs/A Quantified Guide*

# the administrator's passphrase and its hash (docs/deploy-web.md: never in the repository)
pwd
pwd.hash
